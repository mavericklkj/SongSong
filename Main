<script>
'use strict';
/* =================== utils =================== */
const $  = (s, r=document) => r.querySelector(s);
const $$ = (s, r=document) => [...r.querySelectorAll(s)];
const uid = () => (crypto.randomUUID ? crypto.randomUUID() : 'id-' + Date.now() + '-' + Math.random().toString(36).slice(2));
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const num = v => { const n = parseFloat(v); return Number.isFinite(n) ? n : null; };
const round1 = n => Math.round(n * 10) / 10;
const round2 = n => Math.round(n * 100) / 100;

const fmtMoney = (n, signed=false) => {
  const v = Math.abs(n || 0).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2});
  return (n < 0 ? '−$' : (signed && n > 0 ? '+$' : '$')) + v;
};
const fmtShort = n => '$' + Math.round(n).toLocaleString('en-US');
const fmtNum  = n => (Math.round(n * 100) / 100).toLocaleString('en-US', {maximumFractionDigits:2});
const fmtDate = ts => ts ? new Date(ts).toLocaleString(undefined, {month:'short', day:'numeric', hour:'numeric', minute:'2-digit'}) : '—';
const fmtDay  = ts => ts ? new Date(ts).toLocaleDateString(undefined, {month:'short', day:'numeric'}) : '—';
const fmtDur  = ms => {
  if (ms == null || ms < 0) return '—';
  const m = Math.round(ms / 60000);
  if (m < 1)  return '<1m';
  if (m < 60) return m + 'm';
  const h = Math.floor(m / 60), mm = m % 60;
  if (h < 48) return mm ? `${h}h ${mm}m` : `${h}h`;
  return `${Math.floor(h / 24)}d ${h % 24}h`;
};
const fmtAgo = ts => {
  if (!ts) return 'never';
  const d = Date.now() - ts;
  if (d < 90000) return 'just now';
  if (d < 3600e3) return Math.round(d / 60000) + ' min ago';
  if (d < 48 * 3600e3) return Math.round(d / 3600e3) + 'h ago';
  return Math.round(d / 86400e3) + ' days ago';
};
const toLocalInput = ts => {
  if (!ts) return '';
  const d = new Date(ts);
  return new Date(ts - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
};
const fromLocalInput = v => { if (!v) return null; const t = new Date(v).getTime(); return Number.isFinite(t) ? t : null; };
// FX sessions by entry time (UTC hours)
const sessionOf = ts => {
  if (!ts) return '—';
  const h = new Date(ts).getUTCHours();
  if (h >= 7 && h < 12)  return 'London';
  if (h >= 12 && h < 16) return 'London / NY';
  if (h >= 16 && h < 21) return 'New York';
  return 'Asia';
};

/* =================== DB (IndexedDB with in-memory fallback) =================== */
const DB = (() => {
  let db = null, usingMem = false;
  const mem = { trades: new Map(), images: new Map(), meta: new Map() };

  function open() {
    return new Promise(res => {
      if (!window.indexedDB) { usingMem = true; return res(false); }
      let req, settled = false;
      const fallback = () => { if (settled) return; settled = true; usingMem = true; res(false); };
      const ok = () => { if (settled) return; settled = true; res(true); };
      const timer = setTimeout(fallback, 3000);
      try { req = indexedDB.open('tradeJournal', 1); }
      catch (e) { clearTimeout(timer); return fallback(); }
      req.onupgradeneeded = e => {
        const d = e.target.result;
        if (!d.objectStoreNames.contains('trades')) d.createObjectStore('trades', {keyPath:'id'});
        if (!d.objectStoreNames.contains('images')) d.createObjectStore('images', {keyPath:'id'});
        if (!d.objectStoreNames.contains('meta'))   d.createObjectStore('meta',   {keyPath:'key'});
      };
      req.onsuccess = e => { clearTimeout(timer); db = e.target.result; db.onversionchange = () => db.close(); ok(); };
      req.onerror = () => { clearTimeout(timer); fallback(); };
      req.onblocked = () => { clearTimeout(timer); fallback(); };
    });
  }

  function op(store, mode, fns) {
    if (usingMem) return Promise.resolve(fns.mem(mem[store]));
    return new Promise((res, rej) => {
      let r;
      try { r = fns.idb(db.transaction(store, mode).objectStore(store)); }
      catch (e) { return rej(e); }
      r.onsuccess = () => res(r.result);
      r.onerror   = () => rej(r.error);
    });
  }

  return {
    open,
    get:    (s, k) => op(s, 'readonly',  {idb: st => st.get(k),    mem: m => m.get(k)}),
    getAll: s      => op(s, 'readonly',  {idb: st => st.getAll(),  mem: m => [...m.values()]}),
    put:    (s, v) => op(s, 'readwrite', {idb: st => st.put(v),    mem: m => { m.set(v.id ?? v.key, v); }}),
    del:    (s, k) => op(s, 'readwrite', {idb: st => st.delete(k), mem: m => { m.delete(k); }}),
    clear:  s      => op(s, 'readwrite', {idb: st => st.clear(),   mem: m => { m.clear(); }}),
    get usingMemory() { return usingMem; }
  };
})();

const Meta = {
  async get(key, fallback) { const r = await DB.get('meta', key); return r ? r.value : fallback; },
  set: (key, value) => DB.put('meta', {key, value})
};

/* =================== Img (compression + object-URL cache) =================== */
const Img = (() => {
  const urls = new Map();

  async function compress(file) {
    const srcUrl = URL.createObjectURL(file);
    try {
      const img = await new Promise((res, rej) => {
        const i = new Image();
        i.onload = () => res(i);
        i.onerror = () => rej(new Error('decode failed'));
        i.src = srcUrl;
      });
      const MAX = 1400;
      const scale = Math.min(1, MAX / Math.max(img.naturalWidth, img.naturalHeight));
      const w = Math.max(1, Math.round(img.naturalWidth * scale));
      const h = Math.max(1, Math.round(img.naturalHeight * scale));
      const c = document.createElement('canvas');
      c.width = w; c.height = h;
      c.getContext('2d').drawImage(img, 0, 0, w, h);
      const blob = await new Promise(res => c.toBlob(res, 'image/jpeg', 0.72));
      return (blob && blob.size < file.size) ? blob : file;
    } finally { URL.revokeObjectURL(srcUrl); }
  }

  async function save(file) {
    let blob = file;
    try { blob = await compress(file); } catch (e) { /* store original */ }
    const id = uid();
    await DB.put('images', {id, blob, type: blob.type || 'image/jpeg'});
    return id;
  }

  async function urlFor(id) {
    if (urls.has(id)) return urls.get(id);
    const rec = await DB.get('images', id);
    if (!rec) return null;
    const u = URL.createObjectURL(rec.blob);
    urls.set(id, u);
    return u;
  }

  async function remove(id) { await DB.del('images', id); const u = urls.get(id); if (u) { URL.revokeObjectURL(u); urls.delete(id); } }

  return { save, urlFor, remove };
})();

/* =================== Tier engine (rules unchanged) =================== */
const Tier = (() => {
  const RR = 2.2;
  const TIER_COUNT = 5;
  // Each tier risks the previous tier's TP profit: $100 → $220 → $484 → $1,064.80 → $2,342.56
  const TIERS = (() => {
    const out = []; let stake = 100;
    for (let i = 0; i < TIER_COUNT; i++) {
      const tp = Math.round(stake * RR * 100) / 100;
      out.push({ n: i + 1, stake: Math.round(stake * 100) / 100, tp });
      stake = tp;
    }
    return out;
  })();
  const MAX = TIERS.length;

  const stake = t => TIERS[t - 1].stake;
  const tp    = t => TIERS[t - 1].tp;

  const closedSorted = trades =>
    trades.filter(t => t.status === 'closed')
          .sort((a, b) => (a.exitTime || a.entryTime || 0) - (b.exitTime || b.entryTime || 0));

  // Win → up one (capped at top tier), loss → down one (floored at T1), BE → hold.
  function path(trades) {
    let cur = 1;
    const pts = [1];
    for (const t of closedSorted(trades)) {
      if (t.outcome === 'win')  cur = Math.min(MAX, cur + 1);
      else if (t.outcome === 'loss') cur = Math.max(1, cur - 1);
      pts.push(cur);
    }
    return pts;
  }
  const current = trades => path(trades).at(-1);

  // Position sizing: risk ÷ SL pips → "mini con" under 10, otherwise ÷10 as "con"
  function conSize(risk, sl) {
    if (!sl || sl <= 0) return null;
    const size = risk / sl;
    return size < 10 ? { value: size, unit: 'mini con' } : { value: size / 10, unit: 'con' };
  }

  return { RR, TIERS, MAX, stake, tp, path, current, conSize, closedSorted };
})();

/* =================== Trades =================== */
const Trades = {
  // Stake is stored on each trade at open, so changing the ladder never rewrites history.
  stakeOf: t => t.stake ?? Tier.stake(t.tier),
  winOf(t) { const s = Trades.stakeOf(t); return s === Tier.stake(t.tier) ? Tier.tp(t.tier) : round2(s * Tier.RR); },
  rMultiple(t) {
    if (t.status !== 'closed' || t.pnl == null) return null;
    const s = Trades.stakeOf(t);
    return s ? t.pnl / s : null;
  },
  holdMs: t => (t.entryTime && t.exitTime) ? t.exitTime - t.entryTime : null,
  all:    () => DB.getAll('trades'),
  save:   t  => DB.put('trades', t),
  remove: id => DB.del('trades', id)
};

/* =================== Stats =================== */
const Stats = {
  compute(trades) {
    const closed = Tier.closedSorted(trades);
    if (!closed.length) return null;

    const wins   = closed.filter(t => t.outcome === 'win').length;
    const losses = closed.filter(t => t.outcome === 'loss').length;
    const bes    = closed.filter(t => t.outcome === 'be').length;
    const pnls   = closed.map(t => t.pnl || 0);
    const total  = pnls.reduce((a, b) => a + b, 0);
    const rs     = closed.map(t => Trades.rMultiple(t) ?? 0);
    const totalR = rs.reduce((a, b) => a + b, 0);
    const grossW = pnls.filter(p => p > 0).reduce((a, b) => a + b, 0);
    const grossL = Math.abs(pnls.filter(p => p < 0).reduce((a, b) => a + b, 0));

    let run = 0, runType = null, maxWin = 0, maxLoss = 0;
    for (const t of closed) {
      if (t.outcome === 'be') continue;
      if (t.outcome === runType) run++; else { runType = t.outcome; run = 1; }
      if (runType === 'win') maxWin = Math.max(maxWin, run);
      else maxLoss = Math.max(maxLoss, run);
    }

    const holds = closed.map(Trades.holdMs).filter(v => v != null);
    const rrs   = closed.map(t => t.rr).filter(v => v > 0);

    let eq = 0;
    const equity = [0, ...closed.map(t => (eq += t.pnl || 0))];
    const path = Tier.path(trades);

    const groupBy = kind => {
      const m = new Map();
      for (const t of closed) {
        const keys = kind === 'setup'
          ? ((t.setups && t.setups.length) ? t.setups : ['(no setup)'])
          : [kind === 'pair' ? t.pair : kind === 'session' ? sessionOf(t.entryTime) : 'Tier ' + t.tier];
        for (const k of keys) {
          const g = m.get(k) || { n: 0, w: 0, pnl: 0 };
          g.n++; if (t.outcome === 'win') g.w++; g.pnl += t.pnl || 0;
          m.set(k, g);
        }
      }
      const arr = [...m.entries()];
      return kind === 'tier' ? arr.sort((a, b) => a[0].localeCompare(b[0])) : arr.sort((a, b) => b[1].pnl - a[1].pnl);
    };

    return {
      n: closed.length, wins, losses, bes,
      winRate: wins / closed.length * 100,
      beWinRate: 100 / (1 + Tier.RR),
      total, avg: total / closed.length,
      totalR, avgR: totalR / closed.length,
      profitFactor: grossL ? grossW / grossL : (grossW ? Infinity : 0),
      largestWin: Math.max(0, ...pnls),
      largestLoss: Math.min(0, ...pnls),
      curStreak: run, curType: runType, maxWin, maxLoss,
      avgHold: holds.length ? holds.reduce((a, b) => a + b, 0) / holds.length : null,
      avgRR:   rrs.length   ? rrs.reduce((a, b) => a + b, 0) / rrs.length   : null,
      highestTier: Math.max(...path),
      topTierTrades: closed.filter(t => t.tier === Tier.MAX).length,
      equity,
      bySetup: groupBy('setup'), byPair: groupBy('pair'), byTier: groupBy('tier'), bySession: groupBy('session')
    };
  }
};

/* =================== Zip (STORE-only writer, no dependencies) =================== */
const Zip = (() => {
  const TABLE = (() => {
    const t = new Uint32Array(256);
    for (let n = 0; n < 256; n++) {
      let c = n;
      for (let k = 0; k < 8; k++) c = (c & 1) ? 0xEDB88320 ^ (c >>> 1) : c >>> 1;
      t[n] = c >>> 0;
    }
    return t;
  })();
  const crc32 = u8 => {
    let c = 0xFFFFFFFF;
    for (let i = 0; i < u8.length; i++) c = TABLE[(c ^ u8[i]) & 0xFF] ^ (c >>> 8);
    return (c ^ 0xFFFFFFFF) >>> 0;
  };
  const dosDT = d => ({
    time: (d.getHours() << 11) | (d.getMinutes() << 5) | (d.getSeconds() >> 1),
    date: ((d.getFullYear() - 1980) << 9) | ((d.getMonth() + 1) << 5) | d.getDate()
  });

  function build(files) {
    const enc = new TextEncoder();
    const now = dosDT(new Date());
    const parts = [], central = [];
    let offset = 0;

    for (const f of files) {
      const name = enc.encode(f.name);
      const c = crc32(f.data);

      const lh = new DataView(new ArrayBuffer(30));
      lh.setUint32(0, 0x04034b50, true);
      lh.setUint16(4, 20, true);
      lh.setUint16(6, 0x0800, true);
      lh.setUint16(8, 0, true);
      lh.setUint16(10, now.time, true);
      lh.setUint16(12, now.date, true);
      lh.setUint32(14, c, true);
      lh.setUint32(18, f.data.length, true);
      lh.setUint32(22, f.data.length, true);
      lh.setUint16(26, name.length, true);
      parts.push(lh.buffer, name, f.data);

      const ch = new DataView(new ArrayBuffer(46));
      ch.setUint32(0, 0x02014b50, true);
      ch.setUint16(4, 20, true);
      ch.setUint16(6, 20, true);
      ch.setUint16(8, 0x0800, true);
      ch.setUint16(12, now.time, true);
      ch.setUint16(14, now.date, true);
      ch.setUint32(16, c, true);
      ch.setUint32(20, f.data.length, true);
      ch.setUint32(24, f.data.length, true);
      ch.setUint16(28, name.length, true);
      ch.setUint32(42, offset, true);
      central.push(ch.buffer, name);

      offset += 30 + name.length + f.data.length;
    }

    const cdSize = central.reduce((a, b) => a + b.byteLength, 0);
    const end = new DataView(new ArrayBuffer(22));
    end.setUint32(0, 0x06054b50, true);
    end.setUint16(8, files.length, true);
    end.setUint16(10, files.length, true);
    end.setUint32(12, cdSize, true);
    end.setUint32(16, offset, true);

    return new Blob([...parts, ...central, end.buffer], {type: 'application/zip'});
  }

  return { build };
})();

/* =================== Backup =================== */
const Backup = (() => {
  const blobToDataURL = blob => new Promise((res, rej) => {
    const r = new FileReader();
    r.onload = () => res(r.result);
    r.onerror = () => rej(r.error);
    r.readAsDataURL(blob);
  });

  const stamp = () => new Date().toISOString().slice(0, 10);

  function download(blob, name) {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = name;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 5000);
  }

  async function basePayload() {
    return {
      app: 'trade-journal', version: 1,
      exportedAt: new Date().toISOString(),
      trades: await Trades.all(),
      pairs:  await Meta.get('pairs', []),
      setups: await Meta.get('setups', [])
    };
  }

  async function exportJSON() {
    const data = await basePayload();
    const imgs = await DB.getAll('images');
    data.images = [];
    for (const im of imgs) {
      data.images.push({ id: im.id, type: im.type, dataUrl: await blobToDataURL(im.blob) });
    }
    download(new Blob([JSON.stringify(data)], {type:'application/json'}), `trade-journal-${stamp()}.json`);
    await Meta.set('lastBackup', Date.now());
  }

  async function exportZIP() {
    const data = await basePayload();
    const imgs = await DB.getAll('images');
    const ext = t => t === 'image/png' ? 'png' : (t === 'image/webp' ? 'webp' : 'jpg');
    data.imageFiles = {};
    const files = [];
    for (const im of imgs) {
      const name = `images/${im.id}.${ext(im.type)}`;
      data.imageFiles[im.id] = name;
      files.push({ name, data: new Uint8Array(await im.blob.arrayBuffer()) });
    }
    const enc = new TextEncoder();
    files.unshift({ name: 'journal.json', data: enc.encode(JSON.stringify(data, null, 1)) });
    files.push({ name: 'README.txt', data: enc.encode(
      'Trade Journal export\n\njournal.json holds every trade; images/ holds the screenshots.\n' +
      'For a full restore across devices, use the JSON backup (it embeds the screenshots).\n'
    )});
    download(Zip.build(files), `trade-journal-${stamp()}.zip`);
    await Meta.set('lastBackup', Date.now());
  }

  async function importJSON(file) {
    let data;
    try { data = JSON.parse(await file.text()); }
    catch (e) { throw new Error("That file isn't valid JSON."); }
    if (data.app !== 'trade-journal' || !Array.isArray(data.trades)) {
      throw new Error("This doesn't look like a Trade Journal backup.");
    }
    await DB.clear('trades');
    await DB.clear('images');
    for (const t of data.trades) if (t && t.id) await DB.put('trades', t);
    if (Array.isArray(data.images)) {
      for (const im of data.images) {
        if (!im || !im.id || !im.dataUrl) continue;
        try {
          const blob = await (await fetch(im.dataUrl)).blob();
          await DB.put('images', { id: im.id, blob, type: im.type || blob.type });
        } catch (e) { /* skip a corrupt image */ }
      }
    }
    if (Array.isArray(data.pairs))  await Meta.set('pairs',  data.pairs);
    if (Array.isArray(data.setups)) await Meta.set('setups', data.setups);
    return data.trades.length;
  }

  async function eraseAll() {
    await DB.clear('trades');
    await DB.clear('images');
    await DB.clear('meta');
  }

  return { exportJSON, exportZIP, importJSON, eraseAll };
})();

/* =================== UI state =================== */
const DEFAULT_PAIRS  = ['EURUSD', 'XAUUSD', 'GBPUSD', 'USDJPY'];
const DEFAULT_SETUPS = ['Breakout', 'Pullback', 'Reversal', 'Range'];
const State = {
  tab: 'home',
  trades: [],
  pairs: [],
  setups: [],
  lastPair: null,
  lastDir: 'long',
  filters: { status: 'all', pair: 'all', setup: 'all' },
  formDirty: false
};
const view = $('#view');

/* ---------- toasts (with optional action, e.g. Undo) ---------- */
function toast(msg, type = '', opts = {}) {
  const el = document.createElement('div');
  el.className = 'toast ' + type;
  const span = document.createElement('span');
  span.textContent = msg;
  el.appendChild(span);
  // One toast at a time — a stale Undo should never linger under a newer one.
  $$('#toasts .toast').forEach(t => t._close?.());
  let closed = false;
  const close = () => { if (closed) return; closed = true; el.classList.remove('show'); setTimeout(() => el.remove(), 300); };
  el._close = close;
  if (opts.action) {
    const b = document.createElement('button');
    b.className = 'toast-act';
    b.textContent = opts.action;
    b.onclick = () => { close(); opts.onAction?.(); };
    el.appendChild(b);
  }
  $('#toasts').appendChild(el);
  requestAnimationFrame(() => el.classList.add('show'));
  setTimeout(close, opts.duration || (opts.action ? 6000 : 2800));
}

/* ---------- confirm dialog ---------- */
function confirmDialog({title, body, okText = 'OK', danger = false, requireText = null}) {
  return new Promise(resolve => {
    const o = $('#confirm');
    o.innerHTML = `
      <div class="confirm-panel" role="alertdialog" aria-label="${esc(title)}">
        <h3>${esc(title)}</h3>
        <p>${esc(body)}</p>
        ${requireText ? `<input class="input" id="cfInput" placeholder="Type ${esc(requireText)} to confirm" autocomplete="off" autocapitalize="characters">` : ''}
        <div class="row">
          <button class="btn" data-act="no">Cancel</button>
          <button class="btn ${danger ? 'danger' : 'primary'}" data-act="yes" ${requireText ? 'disabled' : ''}>${esc(okText)}</button>
        </div>
      </div>`;
    o.hidden = false;
    requestAnimationFrame(() => o.classList.add('show'));
    const done = ok => {
      o.classList.remove('show');
      setTimeout(() => { o.hidden = true; o.innerHTML = ''; }, 200);
      resolve(ok);
    };
    if (requireText) {
      const inp = $('#cfInput', o), yes = $('[data-act="yes"]', o);
      inp.addEventListener('input', () => { yes.disabled = inp.value.trim().toUpperCase() !== requireText; });
      setTimeout(() => inp.focus(), 60);
    }
    $('[data-act="no"]', o).onclick = () => done(false);
    $('[data-act="yes"]', o).onclick = () => done(true);
    o.onclick = e => { if (e.target === o) done(false); };
  });
}

/* ---------- bottom sheet ---------- */
const Sheet = {
  guard: null,
  open(title, bodyHTML, {footHTML = '', guard = null} = {}) {
    this.guard = guard;
    const o = $('#sheet');
    o.innerHTML = `
      <div class="sheet-panel" role="dialog" aria-modal="true" aria-label="${esc(title)}">
        <div class="sheet-head"><h2>${title}</h2><button class="icon-btn" data-close aria-label="Close">✕</button></div>
        <div class="sheet-body"></div>
        ${footHTML ? `<div class="sheet-foot">${footHTML}</div>` : ''}
      </div>`;
    $('.sheet-body', o).innerHTML = bodyHTML;
    o.hidden = false;
    requestAnimationFrame(() => o.classList.add('show'));
    $('[data-close]', o).onclick = () => this.tryClose();
    o.onclick = e => { if (e.target === o) this.tryClose(); };
    return o;
  },
  isOpen() { return !$('#sheet').hidden; },
  async tryClose() {
    if (this.guard && this.guard()) {
      const ok = await confirmDialog({
        title: 'Discard changes?',
        body: "You have unsaved changes. They'll be lost if you close this.",
        okText: 'Discard', danger: true
      });
      if (!ok) return;
    }
    this.close();
  },
  close() {
    this.guard = null;
    State.formDirty = false;
    const o = $('#sheet');
    o.classList.remove('show');
    setTimeout(() => { o.hidden = true; o.innerHTML = ''; }, 240);
  }
};

/* ---------- lightbox ---------- */
function openLightbox(url) {
  const o = $('#lightbox');
  $('img', o).src = url;
  o.hidden = false;
  requestAnimationFrame(() => o.classList.add('show'));
  o.onclick = closeLightbox;
}
function closeLightbox() {
  const o = $('#lightbox');
  o.classList.remove('show');
  setTimeout(() => { o.hidden = true; $('img', o).src = ''; }, 200);
}

function hydrateImgs(root) {
  $$('img[data-img]', root).forEach(async el => {
    const u = await Img.urlFor(el.dataset.img);
    if (u) { el.src = u; el.onclick = () => openLightbox(u); }
    else el.closest('.thumb-wrap')?.remove();
  });
}
const thumbsHTML = ids => (ids && ids.length)
  ? `<div class="thumbs">${ids.map(id => `<div class="thumb-wrap"><img data-img="${esc(id)}" alt="Screenshot"></div>`).join('')}</div>`
  : '';

/* =================== charts =================== */
function tierPathSVG(pts) {
  if (pts.length < 2) return '<p class="hint">Close trades and your climb will trace itself here.</p>';
  const max = Tier.MAX;
  const w = Math.max(300, (pts.length - 1) * 26 + 28), h = 120, pad = 14;
  const x = i => pad + 12 + i * (w - 2 * pad - 12) / (pts.length - 1);
  const y = t => h - pad - (t - 1) * (h - 2 * pad) / (max - 1);
  let d = `M ${x(0)} ${y(pts[0])}`;
  for (let i = 1; i < pts.length; i++) d += ` L ${x(i)} ${y(pts[i - 1])} L ${x(i)} ${y(pts[i])}`;
  const grid = Tier.TIERS.map(({n: t}) =>
    `<line x1="${pad + 12}" x2="${w - pad}" y1="${y(t)}" y2="${y(t)}" stroke="var(--line)" stroke-dasharray="2 4"/>
     <text x="2" y="${y(t) + 3.5}" font-size="9.5" fill="var(--mut2)">T${t}</text>`).join('');
  const dots = pts.map((t, i) => {
    const col = i === 0 ? 'var(--mut2)' : (t > pts[i - 1] ? 'var(--win)' : t < pts[i - 1] ? 'var(--loss)' : 'var(--mut)');
    return `<circle cx="${x(i)}" cy="${y(t)}" r="3.2" fill="${col}"/>`;
  }).join('');
  return `<div class="path-wrap"><svg class="chart" width="${w}" height="${h}" viewBox="0 0 ${w} ${h}" role="img" aria-label="Tier path">
    ${grid}<path d="${d}" fill="none" stroke="var(--gold)" stroke-width="2"/>${dots}</svg></div>`;
}

function equitySVG(eq) {
  const w = 600, h = 190, pad = 16;
  const min = Math.min(0, ...eq), max = Math.max(0, ...eq);
  const rng = (max - min) || 1;
  const x = i => eq.length === 1 ? w / 2 : pad + i * (w - 2 * pad) / (eq.length - 1);
  const y = v => h - pad - (v - min) * (h - 2 * pad) / rng;
  const pts = eq.map((v, i) => `${x(i)},${y(v)}`).join(' ');
  const last = eq.at(-1);
  const col = last >= 0 ? 'var(--win)' : 'var(--loss)';
  return `<svg class="chart" viewBox="0 0 ${w} ${h}" role="img" aria-label="Equity curve">
    <line x1="${pad}" x2="${w - pad}" y1="${y(0)}" y2="${y(0)}" stroke="var(--line)" stroke-dasharray="3 4"/>
    <polygon points="${pad},${y(0)} ${pts} ${x(eq.length - 1)},${y(0)}" fill="${last >= 0 ? 'var(--win-soft)' : 'var(--loss-soft)'}"/>
    <polyline points="${pts}" fill="none" stroke="${col}" stroke-width="2"/>
    <circle cx="${x(eq.length - 1)}" cy="${y(last)}" r="3.5" fill="${col}"/>
  </svg>`;
}

/* =================== quick actions =================== */
async function quickClose(trade, outcome) {
  const before = Tier.current(State.trades);
  const stake = Trades.stakeOf(trade);
  const pnl = outcome === 'win' ? Trades.winOf(trade) : outcome === 'loss' ? -stake : 0;
  const original = { ...trade };
  await Trades.save({ ...trade, status: 'closed', outcome, pnl, exitTime: Date.now() });
  await refresh();
  const after = Tier.current(State.trades);
  const label = outcome === 'win' ? 'Win' : outcome === 'loss' ? 'Loss' : 'Break-even';
  const move = before !== after ? ` · T${before} → T${after}` : ` · stay T${after}`;
  toast(`${label} ${fmtMoney(pnl, true)}${move}`, outcome === 'loss' ? 'err' : 'win', {
    action: 'Undo',
    onAction: async () => { await Trades.save(original); await refresh(); toast('Close undone'); }
  });
}

async function deleteWithUndo(t) {
  await Trades.remove(t.id);
  Sheet.close();
  await refresh();
  let undone = false;
  toast(`${t.pair} deleted`, '', {
    action: 'Undo',
    onAction: async () => { undone = true; await Trades.save(t); await refresh(); toast('Trade restored', 'win'); }
  });
  // Screenshots are only purged once the undo window has passed.
  setTimeout(async () => {
    if (undone) return;
    for (const id of [...(t.entryImgs || []), ...(t.exitImgs || [])]) await Img.remove(id);
  }, 6500);
}

async function rememberPick(pair, dir) {
  State.lastPair = pair; State.lastDir = dir;
  try { await Meta.set('lastPick', { pair, dir }); } catch (_) {}
}

/* =================== HOME (ladder) =================== */
function openCard(t) {
  const stake = Trades.stakeOf(t), win = Trades.winOf(t);
  const size = Tier.conSize(stake, t.slPips);
  return `
    <section class="card live fade-in" data-id="${esc(t.id)}">
      <div class="card-h">
        <span class="live-dot"></span>
        <h2>${esc(t.pair)}</h2>
        <span class="badge ${t.direction}">${t.direction}</span>
        <span class="badge tier num">T${t.tier}</span>
        <span class="end hint">${fmtAgo(t.entryTime)}</span>
      </div>
      <div class="live-meta num">SL ${fmtNum(t.slPips)} · TP ${fmtNum(t.tpPips)} pips${size ? ` · ${fmtNum(size.value)} ${size.unit}` : ''}</div>
      <div class="qc num">
        <button class="q-win" data-q="win">Win<small>+${fmtShort(win)}</small></button>
        <button class="q-be" data-q="be">BE<small>$0</small></button>
        <button class="q-loss" data-q="loss">Loss<small>−${fmtShort(stake)}</small></button>
      </div>
      <div class="live-foot">
        <button class="link mut" data-detail>Details</button>
        <button class="link" data-full>Close with notes…</button>
      </div>
    </section>`;
}

function ladderCard(cur) {
  const fillPct = (cur - 1) / (Tier.MAX - 1);
  const up = cur < Tier.MAX ? `T${cur + 1}` : `stay T${cur}`;
  const down = cur > 1 ? `T${cur - 1}` : `stay T1`;
  const steps = Tier.TIERS.slice().reverse().map(x => {
    const state = x.n === cur ? 'cur' : x.n < cur ? 'done' : 'ahead';
    if (state === 'cur') return `
      <div class="step cur">
        <span class="node"></span>
        <div><div class="sn">Tier ${x.n}<span class="here">You're here</span></div>
          <div class="srisk num">Risk <b>${fmtMoney(x.stake)}</b></div></div>
        <div class="stp num"><small>Target</small>+${fmtMoney(x.tp)}</div>
      </div>`;
    return `
      <div class="step ${state}">
        <span class="node"></span>
        <div class="sn num">T${x.n}<small>risk ${fmtMoney(x.stake)}</small></div>
        <div class="stp num">+${fmtShort(x.tp)}</div>
      </div>`;
  }).join('');
  return `
    <section class="card ladder-card fade-in">
      <div class="ladder-top">
        <div><div class="eyebrow">Your ladder · ${Tier.RR}R</div>
          <div class="big num">Tier ${cur}<span>/ ${Tier.MAX}</span></div></div>
      </div>
      <div class="climb">
        <div class="fill" style="height:calc((100% - 40px) * ${fillPct})"></div>
        ${steps}
      </div>
      <div class="rules num">
        <span>Win → <b class="pos">${up}</b></span>
        <span>BE → <b>stay</b></span>
        <span>Loss → <b class="neg">${down}</b></span>
      </div>
    </section>`;
}

function nextTradeCard(cur, openCount) {
  const stake = Tier.stake(cur);
  const pair = State.lastPair && State.pairs.includes(State.lastPair) ? State.lastPair : State.pairs[0];
  return `
    <section class="card next fade-in" id="next">
      <div class="card-h"><h2>Next trade</h2><span class="tier-tag num">T${cur} · risk ${fmtMoney(stake)}</span></div>
      ${openCount ? `<div class="warn-line">You already have ${openCount} open trade${openCount > 1 ? 's' : ''}. This one would also be sized at T${cur}.</div>` : ''}
      <div class="chips scroll" id="ntPair">
        ${State.pairs.length ? State.pairs.map(p => `<button type="button" class="chip ${p === pair ? 'on' : ''}" data-v="${esc(p)}">${esc(p)}</button>`).join('')
          : '<span class="hint">Add pairs in Settings first.</span>'}
      </div>
      <div class="seg" id="ntDir" style="margin-top:12px">
        <button type="button" data-v="long" class="win ${State.lastDir !== 'short' ? 'on' : ''}">Long</button>
        <button type="button" data-v="short" class="loss ${State.lastDir === 'short' ? 'on' : ''}">Short</button>
      </div>
      <div class="sl-wrap">
        <div><label class="lbl" for="ntSL">Stop loss (pips)</label>
          <input id="ntSL" class="input big-input num" type="number" step="any" inputmode="decimal" placeholder="0"></div>
        <div class="out-box num"><span>Position size</span><b id="ntSize">—</b></div>
      </div>
      <div class="out-sub num" id="ntSub">Enter your SL to size the trade</div>
      <button class="btn primary block big" id="ntOpen" disabled>Open trade</button>
      <div class="row" style="justify-content:center;margin-top:6px"><button class="link mut" id="ntMore">Add setups, screenshots or notes…</button></div>
    </section>`;
}

function renderHome() {
  const cur = Tier.current(State.trades);
  const open = State.trades.filter(t => t.status === 'open').sort((a, b) => (a.entryTime || 0) - (b.entryTime || 0));
  const closedN = State.trades.filter(t => t.status === 'closed').length;
  view.innerHTML = `
    ${open.map(openCard).join('')}
    ${ladderCard(cur)}
    ${nextTradeCard(cur, open.length)}
    <section class="card fade-in">
      <div class="card-h"><h2>Your climb</h2><span class="end hint num">${closedN} closed</span></div>
      ${tierPathSVG(Tier.path(State.trades))}
    </section>`;

  // open positions
  $$('.live').forEach(card => {
    const t = State.trades.find(x => x.id === card.dataset.id);
    if (!t) return;
    $$('[data-q]', card).forEach(b => b.onclick = async () => {
      $$('[data-q]', card).forEach(x => x.disabled = true);
      try { await quickClose(t, b.dataset.q); } catch (e) { toast('Could not close the trade', 'err'); renderHome(); }
    });
    $('[data-detail]', card).onclick = () => openDetail(t);
    $('[data-full]', card).onclick = () => openCloseForm(t);
  });

  // next trade
  const nt = { pair: $('#ntPair .chip.on')?.dataset.v || null, dir: State.lastDir === 'short' ? 'short' : 'long' };
  const stake = Tier.stake(cur);
  const update = () => {
    const sl = num($('#ntSL').value);
    const size = sl && sl > 0 ? Tier.conSize(stake, sl) : null;
    $('#ntSize').innerHTML = size ? `${fmtNum(size.value)}<small>${size.unit}</small>` : '—';
    $('#ntSub').textContent = size
      ? `TP ${fmtNum(round1(sl * Tier.RR))} pips · target +${fmtMoney(Tier.tp(cur))}`
      : 'Enter your SL to size the trade';
    $('#ntOpen').disabled = !(size && nt.pair);
  };
  $$('#ntPair .chip').forEach(b => b.onclick = () => {
    $$('#ntPair .chip').forEach(x => x.classList.toggle('on', x === b));
    nt.pair = b.dataset.v; update();
  });
  $$('#ntDir button').forEach(b => b.onclick = () => {
    $$('#ntDir button').forEach(x => x.classList.toggle('on', x === b));
    nt.dir = b.dataset.v;
  });
  $('#ntSL').addEventListener('input', update);
  $('#ntSL').addEventListener('keydown', e => { if (e.key === 'Enter' && !$('#ntOpen').disabled) $('#ntOpen').click(); });
  $('#ntMore').onclick = () => openTradeForm(null, { pair: nt.pair, direction: nt.dir, sl: num($('#ntSL').value) ?? '' });
  $('#ntOpen').onclick = async () => {
    const sl = num($('#ntSL').value);
    if (!nt.pair || !sl || sl <= 0) return;
    $('#ntOpen').disabled = true;
    try {
      const t = {
        id: uid(), status: 'open', entryTime: Date.now(), exitImgs: [], entryImgs: [],
        pair: nt.pair, direction: nt.dir, tier: cur, stake, rr: Tier.RR,
        slPips: sl, tpPips: round1(sl * Tier.RR), setups: [], notes: ''
      };
      await Trades.save(t);
      await rememberPick(nt.pair, nt.dir);
      await refresh();
      toast(`${t.pair} ${t.direction} opened · T${cur} risking ${fmtMoney(stake)}`, 'win');
    } catch (e) { toast('Could not open the trade', 'err'); $('#ntOpen').disabled = false; }
  };
  update();
}

/* =================== TRADES tab =================== */
function tradeCard(t) {
  const cls = t.status === 'open' ? 'open' : t.outcome;
  const r = Trades.rMultiple(t);
  const line2 = t.status === 'open'
    ? `SL ${fmtNum(t.slPips)} · TP ${fmtNum(t.tpPips)} · opened ${fmtAgo(t.entryTime)}`
    : `${r != null ? (r >= 0 ? '+' : '−') + fmtNum(Math.abs(r)) + 'R · ' : ''}held ${fmtDur(Trades.holdMs(t))} · ${fmtDay(t.exitTime)}`;
  const pnl = t.status === 'closed'
    ? `<span class="pnl num ${t.pnl > 0 ? 'pos' : t.pnl < 0 ? 'neg' : ''}">${fmtMoney(t.pnl, true)}</span>`
    : `<span class="pnl badge open">Open</span>`;
  return `
    <button class="trade ${cls} fade-in" data-id="${esc(t.id)}">
      <div class="t1">
        <span class="pair">${esc(t.pair)}</span>
        <span class="badge ${t.direction}">${t.direction}</span>
        <span class="badge tier num">T${t.tier}</span>
        ${pnl}
      </div>
      <div class="t2 num">${line2}</div>
      ${(t.setups && t.setups.length) ? `<div class="tags">${t.setups.map(s => `<span class="tag">${esc(s)}</span>`).join('')}</div>` : ''}
    </button>`;
}

function renderTrades() {
  const f = State.filters;
  const pairs  = [...new Set([...State.pairs, ...State.trades.map(t => t.pair)])].filter(Boolean).sort();
  const setups = [...new Set([...State.setups, ...State.trades.flatMap(t => t.setups || [])])].filter(Boolean).sort();
  if (f.pair !== 'all' && !pairs.includes(f.pair)) f.pair = 'all';
  if (f.setup !== 'all' && !setups.includes(f.setup)) f.setup = 'all';

  let list = State.trades;
  if (f.pair !== 'all')  list = list.filter(t => t.pair === f.pair);
  if (f.setup !== 'all') list = list.filter(t => (t.setups || []).includes(f.setup));
  const open   = list.filter(t => t.status === 'open').sort((a, b) => (b.entryTime || 0) - (a.entryTime || 0));
  const closed = list.filter(t => t.status === 'closed').sort((a, b) => (b.exitTime || 0) - (a.exitTime || 0));
  const filtered = f.pair !== 'all' || f.setup !== 'all';

  const opt = (v, cur, label) => `<option value="${esc(v)}" ${v === cur ? 'selected' : ''}>${esc(label)}</option>`;

  let html = `
    <div class="filters">
      <div class="seg" id="fltStatus">
        ${['all', 'open', 'closed'].map(s => `<button data-v="${s}" class="${f.status === s ? 'on' : ''}">${s[0].toUpperCase() + s.slice(1)}</button>`).join('')}
      </div>
      <div class="row">
        <select id="fltPair" class="input">${opt('all', f.pair, 'All pairs')}${pairs.map(p => opt(p, f.pair, p)).join('')}</select>
        <select id="fltSetup" class="input">${opt('all', f.setup, 'All setups')}${setups.map(s => opt(s, f.setup, s)).join('')}</select>
      </div>
    </div>`;

  if (!State.trades.length) {
    html += `
      <div class="empty">
        <div class="glyph">◮</div>
        <p>No trades yet. Open your first one from the Ladder tab, or log one here.</p>
        <button class="btn primary" id="emptyAdd">＋ Log a trade</button>
      </div>`;
  } else {
    if (f.status !== 'closed') {
      html += `<div class="sec-h"><h2>Open</h2><span class="count num">${open.length}</span></div>`;
      html += open.length ? open.map(tradeCard).join('') : `<p class="hint">Nothing open${filtered ? ' for these filters' : ''}.</p>`;
    }
    if (f.status !== 'open') {
      html += `<div class="sec-h"><h2>Closed</h2><span class="count num">${closed.length}</span></div>`;
      html += closed.length ? closed.map(tradeCard).join('') : `<p class="hint">No closed trades${filtered ? ' for these filters' : ''}.</p>`;
    }
  }
  view.innerHTML = html;

  $$('#fltStatus button').forEach(b => b.onclick = () => { f.status = b.dataset.v; renderTrades(); });
  $('#fltPair').onchange  = e => { f.pair  = e.target.value; renderTrades(); };
  $('#fltSetup').onchange = e => { f.setup = e.target.value; renderTrades(); };
  $('#emptyAdd')?.addEventListener('click', () => openTradeForm());
  $$('.trade').forEach(el => el.onclick = () => {
    const t = State.trades.find(x => x.id === el.dataset.id);
    if (t) openDetail(t);
  });
}

/* =================== STATS tab =================== */
const kpi = (label, value, sub = '') =>
  `<div class="kpi"><span>${label}</span><b class="num">${value}</b>${sub ? `<small class="num">${sub}</small>` : ''}</div>`;

function breakdownCard(title, rows) {
  if (!rows.length) return '';
  return `<section class="card"><div class="card-h"><h2>${esc(title)}</h2></div><table class="tbl num"><thead>
    <tr><th></th><th>Trades</th><th>Win %</th><th>P&amp;L</th></tr></thead><tbody>
    ${rows.map(([k, g]) => `<tr><td>${esc(k)}</td><td>${g.n}</td><td>${Math.round(g.w / g.n * 100)}%</td>
      <td class="${g.pnl > 0 ? 'pos' : g.pnl < 0 ? 'neg' : ''}">${fmtMoney(g.pnl, true)}</td></tr>`).join('')}
  </tbody></table></section>`;
}

function renderStats() {
  const s = Stats.compute(State.trades);
  if (!s) {
    view.innerHTML = `
      <div class="empty">
        <div class="glyph">▤</div>
        <p>Stats appear once you've closed your first trade: win rate against break-even, tier performance, sessions, equity curve and more.</p>
        <button class="btn" id="goHome">Go to ladder</button>
      </div>`;
    $('#goHome').onclick = () => switchTab('home');
    return;
  }
  const pf = s.profitFactor === Infinity ? '∞' : fmtNum(s.profitFactor);
  const streak = s.curType ? `${s.curStreak} ${s.curType === 'win' ? 'win' : 'loss'}${s.curStreak > 1 ? (s.curType === 'win' ? 's' : 'es') : ''}` : '—';
  const wr = Math.round(s.winRate * 10) / 10, be = Math.round(s.beWinRate * 100) / 100;
  const edge = wr - be;
  view.innerHTML = `
    <div class="kpis fade-in">
      <div class="kpi hero">
        <div><span>Net P&amp;L</span><b class="num ${s.total > 0 ? 'pos' : s.total < 0 ? 'neg' : ''}">${fmtMoney(s.total, true)}</b></div>
        <div style="text-align:right"><span>${s.n} closed</span><b class="num" style="font-size:15px">${s.wins}W · ${s.losses}L · ${s.bes}BE</b></div>
      </div>
    </div>

    <section class="card fade-in">
      <div class="card-h"><h2>Win rate vs break-even</h2><span class="end num ${edge >= 0 ? 'pos' : 'neg'}" style="font-weight:700">${edge >= 0 ? '+' : '−'}${fmtNum(Math.abs(edge))} pts</span></div>
      <div class="wr-bar"><div class="wr-fill" style="width:${Math.min(100, wr)}%"></div><div class="wr-mark" style="left:${be}%"></div></div>
      <div class="wr-legend num"><span>You: <b style="color:var(--text)">${fmtNum(wr)}%</b></span><span>Break-even at ${Tier.RR}R: <b style="color:var(--text)">${fmtNum(be)}%</b></span></div>
      <div class="mini-grid num">
        <div><span>Highest tier</span><b class="gold">T${s.highestTier}</b></div>
        <div><span>Now</span><b>T${Tier.current(State.trades)}</b></div>
        <div><span>Trades at T${Tier.MAX}</span><b>${s.topTierTrades}</b></div>
      </div>
    </section>

    <div class="kpis">
      ${kpi('Expectancy', (s.avgR >= 0 ? '+' : '−') + fmtNum(Math.abs(s.avgR)) + 'R', 'per trade')}
      ${kpi('Profit factor', pf)}
      ${kpi('Largest win', `<span class="pos">${fmtMoney(s.largestWin, true)}</span>`)}
      ${kpi('Largest loss', `<span class="${s.largestLoss < 0 ? 'neg' : ''}">${fmtMoney(s.largestLoss, true)}</span>`)}
      ${kpi('Current streak', streak, `Best ${s.maxWin}W · worst ${s.maxLoss}L`)}
      ${kpi('Avg hold', fmtDur(s.avgHold), s.avgRR != null ? `Avg R:R ${fmtNum(s.avgRR)}` : '')}
    </div>

    <section class="card"><div class="card-h"><h2>Equity curve</h2></div>${equitySVG(s.equity)}</section>
    ${breakdownCard('By tier', s.byTier)}
    ${breakdownCard('By session', s.bySession)}
    ${breakdownCard('By setup', s.bySetup)}
    ${breakdownCard('By pair', s.byPair)}
    <p class="hint" style="margin:12px 4px 0">Sessions use entry time: Asia 21:00–07:00, London 07:00–12:00, overlap 12:00–16:00, New York 16:00–21:00 UTC.</p>`;
}

/* =================== image picker helper =================== */
function imagePicker(root, thumbsSel, addSel, fileSel, initial, onDirty) {
  const state = { kept: [...initial], added: [], removed: [] };
  const render = () => {
    const el = $(thumbsSel, root);
    el.innerHTML =
      state.kept.map(id => `<div class="thumb-wrap"><img data-img="${esc(id)}" alt="Screenshot"><button type="button" class="rm" data-old="${esc(id)}" aria-label="Remove">✕</button></div>`).join('') +
      state.added.map((n, i) => `<div class="thumb-wrap"><img src="${n.url}" alt="New screenshot"><button type="button" class="rm" data-new="${i}" aria-label="Remove">✕</button></div>`).join('');
    hydrateImgs(el);
    $$('.rm', el).forEach(b => b.onclick = e => {
      e.stopPropagation();
      if (b.dataset.old) { state.removed.push(b.dataset.old); state.kept = state.kept.filter(x => x !== b.dataset.old); }
      else { const n = state.added.splice(+b.dataset.new, 1)[0]; URL.revokeObjectURL(n.url); }
      onDirty(); render();
    });
  };
  $(addSel, root).onclick = () => $(fileSel, root).click();
  $(fileSel, root).addEventListener('change', e => {
    for (const file of e.target.files) {
      if (!file.type.startsWith('image/')) { toast('Skipped a non-image file', 'err'); continue; }
      state.added.push({ file, url: URL.createObjectURL(file) });
    }
    e.target.value = '';
    onDirty(); render();
  });
  render();
  state.commit = async () => {
    const ids = [];
    for (const n of state.added) { ids.push(await Img.save(n.file)); URL.revokeObjectURL(n.url); }
    for (const id of state.removed) await Img.remove(id);
    return [...state.kept, ...ids];
  };
  return state;
}

/* =================== trade form (full) =================== */
function openTradeForm(existing, preset = {}) {
  const isEdit = !!existing;
  const cur = Tier.current(State.trades);
  const f = {
    pair: existing?.pair || preset.pair || State.lastPair || State.pairs[0] || '',
    direction: existing?.direction || preset.direction || State.lastDir || 'long',
    tier: existing?.tier || cur,
    rr: existing?.rr ?? Tier.RR,
    sl: existing?.slPips ?? preset.sl ?? '',
    tp: existing?.tpPips ?? '',
    setups: new Set(existing?.setups || []),
    notes: existing?.notes || '',
    entry: existing?.entryTime || Date.now()
  };
  let tpTouched = isEdit && f.tp !== '';
  const hasExtras = isEdit && ((existing.setups || []).length || (existing.entryImgs || []).length || existing.notes);
  const pairList = [...new Set([...State.pairs, ...(f.pair ? [f.pair] : [])])];
  const stakeFor = tier => (isEdit && tier === existing.tier && existing.stake != null) ? existing.stake : Tier.stake(tier);

  const o = Sheet.open(isEdit ? 'Edit trade' : 'New trade', `
    <div class="field"><label>Pair</label>
      <div class="chips" id="fPair">
        ${pairList.length ? pairList.map(p => `<button type="button" class="chip ${p === f.pair ? 'on' : ''}" data-v="${esc(p)}">${esc(p)}</button>`).join('')
          : '<span class="hint">Add pairs in Settings first.</span>'}
      </div>
    </div>
    <div class="field"><label>Direction</label>
      <div class="seg" id="fDir">
        <button type="button" data-v="long" class="win ${f.direction === 'long' ? 'on' : ''}">Long</button>
        <button type="button" data-v="short" class="loss ${f.direction === 'short' ? 'on' : ''}">Short</button>
      </div>
    </div>
    <div class="field"><label>Tier</label>
      <div class="locked num" id="fTierLocked"><span><b>T${f.tier}</b> · risk ${fmtMoney(stakeFor(f.tier))}</span>
        <span class="hint">${isEdit ? 'as logged' : 'from your ladder'}</span>
        <button type="button" class="link" id="fTierChange">Change</button></div>
      <div class="seg" id="fTier" hidden>
        ${Tier.TIERS.map(t => `<button type="button" data-v="${t.n}" class="gold ${t.n === f.tier ? 'on' : ''}">T${t.n}<small class="num">${fmtShort(t.stake)}</small></button>`).join('')}
      </div>
    </div>
    <div class="row3">
      <div class="field"><label>SL pips</label><input id="fSL" class="input num" type="number" step="any" inputmode="decimal" value="${esc(f.sl)}" placeholder="25"></div>
      <div class="field"><label>R : R</label><input id="fRR" class="input num" type="number" step="any" inputmode="decimal" value="${esc(f.rr)}"></div>
      <div class="field"><label>TP pips</label><input id="fTP" class="input num" type="number" step="any" inputmode="decimal" value="${esc(f.tp)}" placeholder="auto"></div>
    </div>
    <div class="calc-line num" id="fCalc"></div>
    <details class="more" ${hasExtras ? 'open' : ''}>
      <summary>More <small>setups, entry time, screenshots, notes</small></summary>
      <div class="field" style="margin-top:6px"><label>Setups</label>
        <div class="chips" id="fSetups">
          ${State.setups.length ? State.setups.map(s => `<button type="button" class="chip ${f.setups.has(s) ? 'on' : ''}" data-v="${esc(s)}">${esc(s)}</button>`).join('')
            : '<span class="hint">Add setup tags in Settings.</span>'}
        </div>
      </div>
      <div class="field"><label>Entry time</label>
        <input id="fEntry" class="input num" type="datetime-local" value="${toLocalInput(f.entry)}">
      </div>
      <div class="field"><label>Entry screenshots</label>
        <div class="thumbs" id="fThumbs"></div>
        <button type="button" class="btn ghost small" id="fAddImg">＋ Add screenshots</button>
        <input id="fFiles" type="file" accept="image/*" multiple hidden>
      </div>
      <div class="field"><label>Notes</label>
        <textarea id="fNotes" class="input" rows="3" placeholder="Why this trade?">${esc(f.notes)}</textarea>
      </div>
    </details>`,
    { footHTML: `<button class="btn primary big" id="fSave">${isEdit ? 'Save changes' : 'Open trade'}</button>`,
      guard: () => State.formDirty });

  const dirty = () => { State.formDirty = true; };
  const imgs = imagePicker(o, '#fThumbs', '#fAddImg', '#fFiles', existing?.entryImgs || [], dirty);

  const updateCalc = () => {
    const sl = num($('#fSL').value);
    const risk = stakeFor(f.tier);
    const size = sl ? Tier.conSize(risk, sl) : null;
    $('#fCalc').textContent = size
      ? `Risk ${fmtMoney(risk)} · size ${fmtNum(size.value)} ${size.unit}`
      : `Risk ${fmtMoney(risk)} — enter SL pips to size the position`;
  };
  const autoTP = () => {
    if (tpTouched) return;
    const sl = num($('#fSL').value), rr = num($('#fRR').value) ?? Tier.RR;
    $('#fTP').value = (sl && sl > 0) ? round1(sl * rr) : '';
  };

  const wire = (id, fn, multi = false) => $$('#' + id + ' [data-v]').forEach(b => b.onclick = () => {
    if (!multi) { $$('#' + id + ' .on').forEach(x => x.classList.remove('on')); b.classList.add('on'); }
    else b.classList.toggle('on');
    fn(b.dataset.v, b.classList.contains('on'));
    dirty();
  });
  wire('fPair', v => { f.pair = v; });
  wire('fDir', v => { f.direction = v; });
  wire('fTier', v => { f.tier = +v; updateCalc(); });
  wire('fSetups', (v, on) => { on ? f.setups.add(v) : f.setups.delete(v); }, true);
  $('#fTierChange').onclick = () => { $('#fTierLocked').hidden = true; $('#fTier').hidden = false; };

  $('#fRR').addEventListener('input', () => { dirty(); autoTP(); });
  $('#fSL').addEventListener('input', () => { dirty(); autoTP(); updateCalc(); });
  $('#fTP').addEventListener('input', () => { tpTouched = true; dirty(); });
  $('#fNotes').addEventListener('input', dirty);
  $('#fEntry').addEventListener('input', dirty);
  updateCalc(); autoTP();

  $('#fSave').onclick = async () => {
    const rr = num($('#fRR').value), sl = num($('#fSL').value), tp = num($('#fTP').value);
    if (!f.pair) return toast('Pick a pair first', 'err');
    if (!sl || sl <= 0) return toast('SL pips must be above 0', 'err');
    if (!rr || rr <= 0) return toast('R:R must be above 0', 'err');
    const entryTime = fromLocalInput($('#fEntry').value) ?? f.entry;
    if (isEdit && existing.exitTime && entryTime > existing.exitTime) return toast('Entry time is after the exit time', 'err');
    const btn = $('#fSave');
    btn.disabled = true; btn.textContent = 'Saving…';
    try {
      const entryImgs = await imgs.commit();
      const t = existing ? { ...existing } : { id: uid(), status: 'open', exitImgs: [] };
      Object.assign(t, {
        pair: f.pair, direction: f.direction, tier: f.tier, stake: stakeFor(f.tier), rr,
        slPips: sl, tpPips: tp ?? round1(sl * rr), entryTime,
        setups: [...f.setups], notes: $('#fNotes').value.trim(), entryImgs
      });
      await Trades.save(t);
      if (!isEdit) await rememberPick(f.pair, f.direction);
      State.formDirty = false;
      Sheet.close();
      await refresh();
      toast(isEdit ? 'Trade updated' : `${t.pair} ${t.direction} opened · T${t.tier} risking ${fmtMoney(t.stake)}`, 'win');
    } catch (err) {
      btn.disabled = false; btn.textContent = isEdit ? 'Save changes' : 'Open trade';
      toast('Could not save the trade', 'err');
    }
  };
}

/* =================== close / edit-result form =================== */
function openCloseForm(trade) {
  const reclose = trade.status === 'closed';
  const stakeV = Trades.stakeOf(trade), winV = Trades.winOf(trade);
  let outcome = reclose ? trade.outcome : null;
  let pnlTouched = reclose;

  const o = Sheet.open(reclose ? 'Edit result' : `Close ${esc(trade.pair)}`, `
    <div class="field"><label>Outcome</label>
      <div class="seg" id="cOut">
        <button type="button" data-v="win" class="win ${outcome === 'win' ? 'on' : ''}">Win<small class="num">+${fmtShort(winV)}</small></button>
        <button type="button" data-v="be" class="${outcome === 'be' ? 'on' : ''}">BE<small class="num">$0</small></button>
        <button type="button" data-v="loss" class="loss ${outcome === 'loss' ? 'on' : ''}">Loss<small class="num">−${fmtShort(stakeV)}</small></button>
      </div>
    </div>
    <div class="row3" style="grid-template-columns:1fr 1.4fr">
      <div class="field"><label>P&amp;L ($)</label>
        <input id="cPnl" class="input num" type="number" step="any" inputmode="decimal" value="${reclose ? esc(trade.pnl) : ''}" placeholder="auto">
      </div>
      <div class="field"><label>Exit time</label>
        <input id="cExit" class="input num" type="datetime-local" value="${toLocalInput(trade.exitTime || Date.now())}">
      </div>
    </div>
    <div class="field"><label>Exit screenshots</label>
      <div class="thumbs" id="cThumbs"></div>
      <button type="button" class="btn ghost small" id="cAddImg">＋ Add screenshots</button>
      <input id="cFiles" type="file" accept="image/*" multiple hidden>
    </div>
    <div class="field"><label>Close notes</label>
      <textarea id="cNotes" class="input" rows="3" placeholder="How did it play out?">${esc(trade.closeNotes || '')}</textarea>
    </div>`,
    { footHTML: `<button class="btn primary big" id="cSave">${reclose ? 'Save changes' : 'Close trade'}</button>`,
      guard: () => State.formDirty });

  const dirty = () => { State.formDirty = true; };
  const imgs = imagePicker(o, '#cThumbs', '#cAddImg', '#cFiles', trade.exitImgs || [], dirty);

  $$('#cOut button').forEach(b => b.onclick = () => {
    $$('#cOut .on').forEach(x => x.classList.remove('on'));
    b.classList.add('on');
    outcome = b.dataset.v;
    if (!pnlTouched) $('#cPnl').value = outcome === 'win' ? winV : outcome === 'loss' ? -stakeV : 0;
    dirty();
  });
  $('#cPnl').addEventListener('input', () => { pnlTouched = true; dirty(); });
  $('#cNotes').addEventListener('input', dirty);
  $('#cExit').addEventListener('input', dirty);

  $('#cSave').onclick = async () => {
    if (!outcome) return toast('Pick an outcome first', 'err');
    const pnl = num($('#cPnl').value);
    if (pnl == null) return toast('P&L is missing', 'err');
    const exitTime = fromLocalInput($('#cExit').value) ?? Date.now();
    if (trade.entryTime && exitTime < trade.entryTime) return toast('Exit time is before the entry time', 'err');
    const btn = $('#cSave');
    btn.disabled = true; btn.textContent = 'Saving…';
    try {
      const before = Tier.current(State.trades);
      const exitImgs = await imgs.commit();
      await Trades.save({ ...trade, status: 'closed', outcome, pnl, exitTime,
        closeNotes: $('#cNotes').value.trim(), exitImgs });
      State.formDirty = false;
      Sheet.close();
      await refresh();
      const after = Tier.current(State.trades);
      const label = outcome === 'win' ? 'Win' : outcome === 'loss' ? 'Loss' : 'Break-even';
      toast(before !== after ? `${label} logged · T${before} → T${after}` : (reclose ? 'Result updated' : `${label} logged · stay T${after}`),
        outcome === 'loss' ? 'err' : 'win');
    } catch (err) {
      btn.disabled = false; btn.textContent = reclose ? 'Save changes' : 'Close trade';
      toast('Could not save', 'err');
    }
  };
}

/* =================== detail sheet =================== */
function openDetail(t) {
  const r = Trades.rMultiple(t);
  const isOpen = t.status === 'open';
  const size = Tier.conSize(Trades.stakeOf(t), t.slPips);
  const info = [
    ['Direction', `<span class="${t.direction === 'long' ? 'pos' : 'neg'}" style="text-transform:capitalize">${esc(t.direction)}</span>`],
    ['Tier', `T${t.tier} · ${fmtMoney(Trades.stakeOf(t))}`],
    ['SL / TP pips', `${fmtNum(t.slPips)} / ${fmtNum(t.tpPips)}`],
    ['Size', size ? `${fmtNum(size.value)} ${size.unit}` : '—'],
    ['Opened', fmtDate(t.entryTime)],
    ['Session', sessionOf(t.entryTime)],
    ...(!isOpen ? [
      ['Closed', fmtDate(t.exitTime)],
      ['Hold time', fmtDur(Trades.holdMs(t))],
      ['P&L', `<span class="${t.pnl > 0 ? 'pos' : t.pnl < 0 ? 'neg' : ''}">${fmtMoney(t.pnl, true)}</span>`],
      ['R multiple', r != null ? `${r >= 0 ? '+' : '−'}${fmtNum(Math.abs(r))}R` : '—']
    ] : [['R : R', fmtNum(t.rr)], ['Status', '<span style="color:var(--open)">Open</span>']])
  ];

  const foot = isOpen
    ? `<button class="btn primary" id="dClose">Close trade</button><button class="btn" id="dEdit">Edit</button><button class="btn danger ghost" id="dDel" aria-label="Delete">🗑</button>`
    : `<button class="btn primary" id="dResult">Edit result</button><button class="btn" id="dEdit">Edit details</button><button class="btn danger ghost" id="dDel" aria-label="Delete">🗑</button>`;

  const title = `${esc(t.pair)} <span class="badge ${t.direction}" style="vertical-align:3px">${t.direction}</span>`;
  const o = Sheet.open(title, `
    <div class="info-grid num">${info.map(([k, v]) => `<div><span>${k}</span><b>${v}</b></div>`).join('')}</div>
    ${(t.setups && t.setups.length) ? `<div class="tags" style="margin-top:14px">${t.setups.map(s => `<span class="tag">${esc(s)}</span>`).join('')}</div>` : ''}
    ${t.notes ? `<div class="notes-block">${esc(t.notes)}</div>` : ''}
    ${(t.entryImgs && t.entryImgs.length) ? `<div class="field"><label>Entry screenshots</label>${thumbsHTML(t.entryImgs)}</div>` : ''}
    ${t.closeNotes ? `<div class="field"><label>Close notes</label><div class="notes-block" style="margin-top:0">${esc(t.closeNotes)}</div></div>` : ''}
    ${(t.exitImgs && t.exitImgs.length) ? `<div class="field"><label>Exit screenshots</label>${thumbsHTML(t.exitImgs)}</div>` : ''}`,
    { footHTML: foot });
  hydrateImgs(o);

  $('#dEdit', o).onclick = () => openTradeForm(t);
  $('#dClose', o) && ($('#dClose', o).onclick = () => openCloseForm(t));
  $('#dResult', o) && ($('#dResult', o).onclick = () => openCloseForm(t));
  $('#dDel', o).onclick = () => deleteWithUndo(t);
}

/* =================== SETTINGS tab (lists + backup) =================== */
const BACKUP_STALE_MS = 7 * 86400e3;
async function backupOverdue() {
  const last = await Meta.get('lastBackup', null);
  return State.trades.length > 0 && (!last || Date.now() - last > BACKUP_STALE_MS);
}

async function renderSettings() {
  const last = await Meta.get('lastBackup', null);
  const overdue = await backupOverdue();
  const listCard = (title, key, items, placeholder, caps, hint) => `
    <section class="card">
      <div class="card-h"><h2>${title}</h2><span class="end hint">${hint}</span></div>
      <div class="chips">
        ${items.length ? items.map(v => `<button class="chip on" data-list="${key}" data-v="${esc(v)}" aria-label="Remove ${esc(v)}">${esc(v)}<span class="x">✕</span></button>`).join('')
          : `<span class="hint">Nothing here yet.</span>`}
      </div>
      <div class="add-row">
        <input class="input ${caps ? '' : 'nocaps'}" id="add-${key}" placeholder="${placeholder}" autocomplete="off">
        <button class="btn" data-add="${key}">Add</button>
      </div>
    </section>`;

  view.innerHTML = `
    ${DB.usingMemory ? `<section class="card"><p class="hint" style="color:#ffb4b4">Storage is unavailable in this browser session — export a backup before closing this tab.</p></section>` : ''}
    <div class="set-group fade-in" style="margin-top:8px">
      <div class="eyebrow">Journal</div>
      ${listCard('Pairs', 'pairs', State.pairs, 'e.g. AUDUSD', true, 'quick-pick chips')}
      ${listCard('Setup tags', 'setups', State.setups, 'e.g. Breakout', false, 'tag trades')}
      <p class="hint" style="margin:10px 4px 0">Removing one never touches trades already logged with it.</p>
    </div>

    <div class="set-group">
      <div class="eyebrow">Backup</div>
      <section class="card">
        <div class="bk-status ${overdue ? 'warn' : ''} num"><span class="led"></span>
          Last backup ${fmtAgo(last)}${overdue ? ' — time to back up' : ''}</div>
        <p class="bk-desc">Everything lives only on this device. The JSON backup holds trades, settings and screenshots and is what you restore from. The ZIP is a browsable copy with screenshots as image files.</p>
        <div class="btn-pair">
          <button class="btn primary" id="bkJson">Export JSON</button>
          <button class="btn" id="bkZip">Export ZIP</button>
        </div>
      </section>
      <section class="card">
        <div class="card-h"><h2>Restore</h2></div>
        <p class="bk-desc" style="margin-top:-6px">Import a JSON backup. This replaces everything currently on this device.</p>
        <button class="btn block" id="bkImport">Import backup…</button>
        <input type="file" id="bkFile" accept=".json,application/json" hidden>
      </section>
    </div>

    <div class="set-group">
      <div class="eyebrow">Danger zone</div>
      <section class="card">
        <p class="bk-desc" style="margin-top:0">Wipe every trade, screenshot and setting from this device.</p>
        <button class="btn danger block" id="bkErase">Erase all data</button>
      </section>
    </div>`;

  // lists
  const saveList = async key => { await Meta.set(key, State[key]); renderSettings(); };
  $$('[data-list]').forEach(b => b.onclick = async () => {
    const key = b.dataset.list, v = b.dataset.v;
    State[key] = State[key].filter(x => x !== v);
    await saveList(key);
    toast(`Removed ${v}`, '', { action: 'Undo', onAction: async () => {
      if (!State[key].includes(v)) { State[key].push(v); await Meta.set(key, State[key]); }
      if (State.tab === 'settings') renderSettings();
    }});
  });
  $$('[data-add]').forEach(b => b.onclick = async () => {
    const key = b.dataset.add;
    const inp = $('#add-' + key);
    let v = inp.value.trim();
    if (key === 'pairs') v = v.toUpperCase();
    if (!v) return;
    if (State[key].some(x => x.toLowerCase() === v.toLowerCase())) return toast('Already in the list', 'err');
    State[key].push(v);
    await saveList(key);
    toast(`Added ${v}`, 'win');
  });
  $$('.add-row .input').forEach(inp => inp.addEventListener('keydown', e => {
    if (e.key === 'Enter') $(`[data-add="${inp.id.slice(4)}"]`).click();
  }));

  // backup
  const busy = (btn, label, fn) => async () => {
    const old = btn.textContent;
    btn.disabled = true; btn.textContent = label;
    try { await fn(); }
    catch (e) { toast(e.message || 'Something went wrong', 'err'); }
    finally { btn.disabled = false; btn.textContent = old; updateSettingsDot(); if (State.tab === 'settings') renderSettings(); }
  };
  const j = $('#bkJson'), z = $('#bkZip');
  j.onclick = busy(j, 'Exporting…', async () => { await Backup.exportJSON(); toast('Backup exported', 'win'); });
  z.onclick = busy(z, 'Building…', async () => { await Backup.exportZIP(); toast('ZIP exported', 'win'); });

  $('#bkImport').onclick = () => $('#bkFile').click();
  $('#bkFile').addEventListener('change', async e => {
    const file = e.target.files[0];
    e.target.value = '';
    if (!file) return;
    const ok = await confirmDialog({
      title: 'Restore from backup?',
      body: `Everything on this device will be replaced by the contents of “${file.name}”.`,
      okText: 'Restore', danger: true
    });
    if (!ok) return;
    try {
      const n = await Backup.importJSON(file);
      State.pairs  = await Meta.get('pairs', []);
      State.setups = await Meta.get('setups', []);
      await refresh();
      toast(`Restored ${n} trade${n === 1 ? '' : 's'}`, 'win');
    } catch (err) { toast(err.message || 'Restore failed', 'err'); }
  });

  $('#bkErase').onclick = async () => {
    const ok = await confirmDialog({
      title: 'Erase everything?',
      body: 'All trades, screenshots and settings will be permanently deleted from this device. There is no undo.',
      okText: 'Erase', danger: true, requireText: 'ERASE'
    });
    if (!ok) return;
    await Backup.eraseAll();
    State.pairs = []; State.setups = []; State.lastPair = null;
    await refresh();
    toast('All data erased');
  };
}

/* =================== navigation + boot =================== */
const RENDER = { home: renderHome, trades: renderTrades, stats: renderStats, settings: renderSettings };

function switchTab(tab) {
  if (!RENDER[tab]) tab = 'home';
  State.tab = tab;
  $$('.tabs button').forEach(b => b.classList.toggle('on', b.dataset.tab === tab));
  $('#fab').hidden = tab !== 'trades';
  RENDER[tab]();
  window.scrollTo(0, 0);
}

function rerender() { RENDER[State.tab](); }

function updateTierPill() {
  const cur = Tier.current(State.trades);
  $('#tierPill').textContent = `T${cur} · ${fmtShort(Tier.stake(cur))}`;
}

async function updateSettingsDot() {
  const nav = $('#navSettings');
  $('.dot', nav)?.remove();
  if (await backupOverdue()) {
    const d = document.createElement('span');
    d.className = 'dot';
    nav.appendChild(d);
  }
}

async function refresh() {
  State.trades = await Trades.all();
  updateTierPill();
  updateSettingsDot();
  rerender();
}

function wireControls() {
  $$('.tabs button').forEach(b => b.onclick = () => switchTab(b.dataset.tab));
  $('#fab').onclick = () => openTradeForm();
  $('#tierPill').onclick = () => switchTab('home');

  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    if (!$('#lightbox').hidden) return closeLightbox();
    if (!$('#confirm').hidden) return;
    if (Sheet.isOpen()) Sheet.tryClose();
  });
  window.addEventListener('beforeunload', e => {
    if (State.formDirty) { e.preventDefault(); e.returnValue = ''; }
  });
}

async function loadData() {
  const ok = await DB.open();
  if (!ok) $('#storageWarn').hidden = false;

  let pairs = await Meta.get('pairs', null);
  if (!pairs) { pairs = [...DEFAULT_PAIRS]; await Meta.set('pairs', pairs); }
  let setups = await Meta.get('setups', null);
  if (!setups) { setups = [...DEFAULT_SETUPS]; await Meta.set('setups', setups); }
  const pick = await Meta.get('lastPick', null);
  State.pairs = pairs;
  State.setups = setups;
  if (pick) { State.lastPair = pick.pair; State.lastDir = pick.dir || 'long'; }
  State.trades = await Trades.all();
}

async function boot() {
  try { wireControls(); } catch (e) { console.error('wire failed', e); }
  try { State.pairs = [...DEFAULT_PAIRS]; State.setups = [...DEFAULT_SETUPS]; switchTab('home'); } catch (e) { console.error('initial render failed', e); }

  try {
    await loadData();
  } catch (e) {
    console.error('storage init failed, using session-only mode', e);
    $('#storageWarn').hidden = false;
  }

  updateTierPill();
  updateSettingsDot();
  switchTab(State.tab || 'home');

  try {
    if (await backupOverdue()) {
      setTimeout(() => toast("It's been a while since your last backup — export one from Settings."), 1200);
    }
  } catch (_) {}
}

if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
else boot();
</script>
</body>
</html>
